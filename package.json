{
  "name": "portena-actividad-3",
  "version": "1.0.0",
  "private": true,
  "description": "Recorridos culturales por Buenos Aires. HTML5, Tailwind CSS y JavaScript.",
  "scripts": {
    "build:css": "tailwindcss -i ./css/entrada.css -o ./css/styles.css",
    "watch:css": "tailwindcss -i ./css/entrada.css -o ./css/styles.css --watch",
    "start": "node scripts/servidor.cjs",
    "build:content": "node scripts/generar-ayuda.cjs",
    "build": "npm run build:content && npm run build:css"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "tailwindcss": "3.4.17"
  }
}
